# ===========================================
# HypeFlow Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values
# Run: cp .env.example .env

# ===========================================
# Database Configuration
# ===========================================
MYSQL_ROOT_PASSWORD=changeMe
MYSQL_DATABASE=hypeflow

# ===========================================
# External API Keys (Optional)
# ===========================================

# NewsAPI - Get your key at: https://newsapi.org/register
HYPEFLOW_NEWSAPI_API_KEY=

# Reddit OAuth (optional, disabled by default)
# Create app at: https://www.reddit.com/prefs/apps
HYPEFLOW_REDDIT_CLIENT_ID=
HYPEFLOW_REDDIT_CLIENT_SECRET=
HYPEFLOW_REDDIT_USERNAME=

# ===========================================
# Notes
# ===========================================
# The following sources work WITHOUT API keys:
# - Wikipedia
# - GDELT
# - HackerNews
# - StackExchange
# - ArXiv
